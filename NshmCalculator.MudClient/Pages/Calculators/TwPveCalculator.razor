@page "/"
@page "/tw-pve"
@using System.Text.Json
@using Color = MudBlazor.Color
@using Blazored.LocalStorage
@using NshmCalculator.Shared.Research
@using NshmCalculator.Shared.Models.CalculatorModel.CalculatorConfig
@using NshmCalculator.MudClient.Resources
@using NshmCalculator.MudClient.Components
@inject HttpClient Client
@inject ISyncLocalStorageService LocalStorage
<PageTitle>@TwPveText.Title</PageTitle>
<MudStack Spacing="4">
    <MudPaper Class="pa-6"><MudText Typo="Typo.h4">@TwPveText.Title</MudText><MudText>台服研究版｜手遊</MudText><MudText Color="Color.Warning">@TwPveText.Uncalibrated</MudText></MudPaper>
    @if (_manifest is null) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6"><MudSelect T="string" Label="資料版本" Value="_packId" ValueChanged="ChangePack">
                @foreach (var p in _manifest.DataPacks) { <MudSelectItem T="string" Value="@p.Id">@p.Id · @p.GameVersion</MudSelectItem> }
            </MudSelect></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="string" Label="流派" Value="_professionId" ValueChanged="ChangeProfession">
                @foreach (var p in _manifest.Professions) { <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem> }
            </MudSelect></MudItem>
        </MudGrid>
        <MudText Typo="Typo.body2">資料：@Pack.DataVersion｜模型：@Pack.ModelVersion｜目標：@Pack.TargetDataVersion</MudText>
        <MudAlert Severity="Severity.Info">@Pack.Note @TwPveText.LegacyExample</MudAlert>
        <MudSelect T="string" Label="流派套路／姿態" Value="_mode" ValueChanged="ChangeMode">
            @foreach (var p in Profile.LegacyModes) { <MudSelectItem T="string" Value="@p.Key">@p.Value</MudSelectItem> }
        </MudSelect>
        <MudCheckBox T="bool" Checked="_cross" CheckedChanged="ChangeCross" Label="啟用跨流派比較" />
        @if (_cross)
        {
            <MudAlert Severity="Severity.Warning">@PveComparison.CrossProfessionWarning</MudAlert>
            <MudSelect T="string" Label="Build B 流派" Value="_professionB" ValueChanged="ChangeProfessionB">
                @foreach (var p in _manifest.Professions) { <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Build B 套路／姿態" Value="_modeB" ValueChanged="ChangeModeB">
                @foreach (var p in ProfileB.LegacyModes) { <MudSelectItem T="string" Value="@p.Key">@p.Value</MudSelectItem> }
            </MudSelect>
        }
        @if (_a is not null && _b is not null)
        {
            <MudGrid><MudItem xs="12" md="6"><TwBuildEditor @key="_a" Title="目前 Build A" Build="_a" Profile="Profile" /></MudItem><MudItem xs="12" md="6"><TwBuildEditor @key="_b" Title="候選 Build B" Build="_b" Profile="ProfileB" /></MudItem></MudGrid>
            <MudStack Row="true"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Calculate">比較模型值</MudButton><MudButton OnClick="Save">儲存此流派 A/B</MudButton><MudButton Href="/pve">原版 Legacy 計算器</MudButton></MudStack>
        }
        @if (_result is not null)
        {
            <MudPaper Class="pa-5"><MudText Typo="Typo.h6">Build 比較結果</MudText><MudText>A 模型值：@_result.ModelA.ToString("N2")</MudText><MudText>B 模型值：@_result.ModelB.ToString("N2")</MudText>
                @if (_result.Ratio is double ratio) { <MudText Typo="Typo.h5">相對提升：@((ratio - 1).ToString("+0.00%;-0.00%;0.00%"))</MudText> }
                else { <MudText>@PveComparison.CrossProfessionWarning</MudText> }
                <MudText>預測 DPS／誤差區間：待該流派、Build、目標與循環完成獨立校準。</MudText><MudText Typo="Typo.body2">模型值為原 Repo 係數傷害指標，台服適用性待驗證。</MudText>
            </MudPaper>
        }
        @if (!string.IsNullOrWhiteSpace(_manifest.MasterSheetUrl))
        {
            <MudLink Href="@_manifest.MasterSheetUrl" Target="_blank">傷害研究主檔</MudLink>
        }
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
</MudStack>
@code {
    private ResearchManifest? _manifest;
    private string _packId = "", _professionId = "", _professionB = "", _mode = "", _modeB = "", _configJson = "";
    private bool _cross;
    private ResearchBuild? _a, _b;
    private ComparisonResult? _result;
    private string? _error;
    private PveDataPack Pack => _manifest!.DataPacks.Single(p => p.Id == _packId);
    private ProfessionProfile Profile => _manifest!.Professions.Single(p => p.Id == _professionId);
    private ProfessionProfile ProfileB => _manifest!.Professions.Single(p => p.Id == _professionB);
    protected override async Task OnInitializedAsync()
    {
        try { _manifest = await Client.GetFromJsonAsync<ResearchManifest>("data/pve/manifest.json") ?? throw new Exception("無法載入資料索引"); _packId = _manifest.DataPacks[0].Id; _professionId = _manifest.DefaultProfessionId; _professionB = _professionId; await LoadPack(); }
        catch (Exception ex) { _error = ex.Message; }
    }
    private async Task ChangePack(string id) { _packId = id; await LoadPack(); }
    private async Task LoadPack() { _configJson = await Client.GetStringAsync(Pack.ConfigPath); ResetPair(); }
    private void ChangeProfession(string id) { _professionId = id; _professionB = id; _cross = false; ResetPair(); }
    private void ChangeMode(string mode) { _mode = mode; ResetPair(mode); }
    private void ChangeModeB(string mode) { _modeB = mode; _b = Example(ProfileB, mode); _result = null; }
    private void ChangeProfessionB(string id) { _professionB = id; _modeB = ProfileB.LegacyModes.Keys.First(); _b = Example(ProfileB, _modeB); _result = null; }
    private void ChangeCross(bool value) { _cross = value; _result = null; if (!value) { _professionB = _professionId; _modeB = _mode; _b = Example(Profile, _mode); } }
    private ResearchBuild Example(ProfessionProfile profile, string mode) => PveComparison.CreateLegacyExample(JsonSerializer.Deserialize<PveConfig>(_configJson)!, profile, mode);
    private void ResetPair(string? mode = null)
    {
        _mode = mode ?? Profile.LegacyModes.Keys.First(); _modeB = _mode; _professionB = _professionId;
        _a = Example(Profile, _mode); _b = Example(Profile, _mode); _result = null; _error = null;
        var key = PveComparison.StorageKey(Pack, _professionId) + ":" + _mode;
        if (LocalStorage.ContainKey(key)) { var saved = LocalStorage.GetItem<ResearchBuild[]>(key); if (saved?.Length == 2 && saved.All(b => b.ProfessionId == _professionId && b.LegacyMode == _mode)) { _a = saved[0]; _b = saved[1]; } }
    }
    private void Save() { if (_cross) { _error = "跨流派設定請分別切回各流派儲存，避免覆寫同流派基準。"; return; } LocalStorage.SetItem(PveComparison.StorageKey(Pack, _professionId) + ":" + _mode, new[] { _a, _b }); _error = null; }
    private void Calculate() { try { _result = PveComparison.Compare(_configJson, _a!, Profile, _b!, ProfileB, _cross); _error = null; } catch (Exception ex) { _result = null; _error = ex.Message; } }
}
