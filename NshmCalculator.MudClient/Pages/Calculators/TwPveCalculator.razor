@page "/"
@page "/tw-pve"
@using System.Text.Json
@using Color = MudBlazor.Color
@using Blazored.LocalStorage
@using NshmCalculator.Shared.Research
@using NshmCalculator.Shared.Models.CalculatorModel.CalculatorConfig
@using NshmCalculator.MudClient.Resources
@using NshmCalculator.MudClient.Components
@using NshmCalculator.Shared.Research.Artifacts
@inject HttpClient Client
@inject ISyncLocalStorageService LocalStorage
<PageTitle>@TwPveText.Title</PageTitle>
<MudStack Spacing="4">
    <MudPaper Class="pa-6"><MudText Typo="Typo.h4">@TwPveText.Title</MudText><MudText>台服研究版｜手遊</MudText><MudText Color="Color.Warning">@TwPveText.Uncalibrated</MudText></MudPaper>
    @if (_manifest is null) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6"><MudSelect T="string" Label="資料版本" Value="_packId" ValueChanged="ChangePack">
                @foreach (var p in _manifest.DataPacks) { <MudSelectItem T="string" Value="@p.Id">@p.Id · @p.GameVersion</MudSelectItem> }
            </MudSelect></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="string" Label="流派" Value="_professionId" ValueChanged="ChangeProfession">
                @foreach (var p in _manifest.Professions) { <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem> }
            </MudSelect></MudItem>
        </MudGrid>
        @if (IsTw && _targets is not null && _target is not null) { <TwTargetInspector Model="_targets" Selection="_target" Changed="ChangeTarget" A="_twA" B="_twB" /> }
        <MudText Typo="Typo.body2">資料：@Pack.DataVersion｜模型：@Pack.ModelVersion｜目標：@Pack.TargetDataVersion</MudText>
        <MudAlert Severity="Severity.Info">@Pack.Note @TwPveText.LegacyExample</MudAlert>
        <MudSelect T="string" Label="流派套路／姿態" Value="_mode" ValueChanged="ChangeMode">
            @foreach (var p in Profile.LegacyModes) { <MudSelectItem T="string" Value="@p.Key">@p.Value</MudSelectItem> }
        </MudSelect>
        <MudCheckBox T="bool" Checked="_cross" CheckedChanged="ChangeCross" Label="啟用跨流派比較" />
        @if (_cross)
        {
            <MudAlert Severity="Severity.Warning">@PveComparison.CrossProfessionWarning</MudAlert>
            <MudSelect T="string" Label="Build B 流派" Value="_professionB" ValueChanged="ChangeProfessionB">
                @foreach (var p in _manifest.Professions) { <MudSelectItem T="string" Value="@p.Id">@p.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Build B 套路／姿態" Value="_modeB" ValueChanged="ChangeModeB">
                @foreach (var p in ProfileB.LegacyModes) { <MudSelectItem T="string" Value="@p.Key">@p.Value</MudSelectItem> }
            </MudSelect>
        }
        @if (_a is not null && _b is not null)
        {
            @if (_artifactEngine is not null && _artifactLayout is not null)
            {
                <MudStack Row="true">
                    <MudButton Variant="@(_artifactB ? Variant.Outlined : Variant.Filled)" OnClick="() => SelectArtifactBuild(false)">編輯 Build A 神器</MudButton>
                    <MudButton Variant="@(_artifactB ? Variant.Filled : Variant.Outlined)" OnClick="() => SelectArtifactBuild(true)">編輯 Build B 神器</MudButton>
                </MudStack>
                <TwArtifactBoard Build="@(_artifactB ? _b : _a)" Title="@(_artifactB ? "Build B" : "Build A")" Engine="_artifactEngine" Layout="_artifactLayout" Changed="BuildChanged" />
                <TwAttributeComparison A="_a" B="_b" Engine="_artifactEngine" ActualPanel="IsTw" Anchor="_anchor" ActualAdapter="_actualPanels" />
            }
            @if (_artifactError is not null) { <MudAlert Severity="Severity.Error">神器資料載入失敗：@_artifactError</MudAlert> }
            <MudGrid><MudItem xs="12" md="6"><TwBuildEditor @key="_a" Title="目前 Build A" Build="_a" Profile="Profile" ArtifactEngine="_artifactEngine" LegacyAdapter="_legacyAdapter" TwEffects="@(IsTw ? _twEffects : null)" ActualPanel="IsTw" BuildTag="A" Changed="BuildChanged" /></MudItem><MudItem xs="12" md="6"><TwBuildEditor @key="_b" Title="候選 Build B" Build="_b" Profile="ProfileB" ArtifactEngine="_artifactEngine" LegacyAdapter="_legacyAdapter" TwEffects="@(IsTw ? _twEffects : null)" ActualPanel="IsTw" BuildTag="B" Changed="BuildChanged" /></MudItem></MudGrid>
            @if (IsTw) {
                <MudAlert Severity="Severity.Info">輸入目前實際脫戰面板（已含神器），避免短暫Buff，並確認 Build A 是目前實際盤。不需要拆掉神器。</MudAlert>
                <MudButton data-testid="capture-anchor" OnClick="CaptureAnchor">@(_anchor is null ? "建立錨點，並以目前盤初始化候選盤" : "更新目前錨點（保留候選盤）")</MudButton>
                @if (_anchor is not null) {
                    <p data-testid="anchor-status">錨點 @_anchor.Id · @(_actualPanels!.Matches(_anchor,_a) ? "目前資料一致" : "目前資料已修改，請明確更新錨點；舊錨點仍保留")</p>
                    <MudButton data-testid="copy-current-candidate" OnClick="CopyCurrentToCandidate">候選盤複製固定目前盤</MudButton>
                }
            }
            @if (_legacyAdapter is not null)
            {
                <MudButton Variant="Variant.Filled" data-testid="generate-mapped-inputs" OnClick="GenerateMappedInputs">產生 A/B 映射輸入快照</MudButton>
                @if (_inputPair is not null) { <TwLegacyInputSnapshots Pair="_inputPair" TwIsolationResolved="@(IsTw && _twA is not null)" /> }
            }
            @if (_twA is not null && _twB is not null) { <TwArtifactExecutionSnapshots A="_twA" B="_twB" /> }
            @if (_mappingError is not null) { <MudAlert Severity="Severity.Error">映射規格載入失敗：@_mappingError</MudAlert> }
            <MudAlert Severity="Severity.Info">TW 快照使用新神器來源，保留候選模型情境，未校準 DPS。要使用原有計算方式，請切換 Legacy 資料版本或開啟原版計算器。</MudAlert>
            <MudStack Row="true">@if (!IsTw) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Calculate">比較 Legacy 模型值</MudButton> }<MudButton OnClick="Save">儲存此流派 A/B</MudButton><MudButton Href="/pve">原版 Legacy 計算器</MudButton></MudStack>
            @if (_saveMessage is not null) { <MudAlert Severity="Severity.Success" role="status">@_saveMessage</MudAlert> }
        }
        @if (_result is not null)
        {
            <MudPaper Class="pa-5"><MudText Typo="Typo.h6">Build 比較結果</MudText><MudText>A 模型值：@_result.ModelA.ToString("N2")</MudText><MudText>B 模型值：@_result.ModelB.ToString("N2")</MudText>
                @if (_result.Ratio is double ratio) { <MudText Typo="Typo.h5">相對提升：@((ratio - 1).ToString("+0.00%;-0.00%;0.00%"))</MudText> }
                else { <MudText>@PveComparison.CrossProfessionWarning</MudText> }
                <MudText>預測 DPS／誤差區間：待該流派、Build、目標與循環完成獨立校準。</MudText><MudText Typo="Typo.body2">模型值為原 Repo 係數傷害指標，台服適用性待驗證。</MudText>
            </MudPaper>
        }
        @if (!string.IsNullOrWhiteSpace(_manifest.MasterSheetUrl))
        {
            <MudLink Href="@_manifest.MasterSheetUrl" Target="_blank">傷害研究主檔</MudLink>
        }
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
</MudStack>
@code {
    private ResearchManifest? _manifest;
    private string _packId = "", _professionId = "", _professionB = "", _mode = "", _modeB = "", _configJson = "";
    private bool _cross;
    private ResearchBuild? _a, _b;
    private ComparisonResult? _result;
    private string? _error;
    private ArtifactBoardEngine? _artifactEngine;
    private ArtifactBoardLayout? _artifactLayout;
    private string? _artifactError, _saveMessage;
    private LegacyStaticInputAdapter? _legacyAdapter;
    private LegacyInputPair? _inputPair;
    private string _mappingJson = "", _effectPolicyJson = "";
    private TwArtifactEffectAdapter? _twEffects;
    private TwArtifactPveAdapter? _twAdapter;
    private TwArtifactPreparedInputs? _twA, _twB;
    private TwTargetModel? _targets;
    private TwTargetSelection? _target;
    private TwActualPanelAdapter? _actualPanels;
    private TwActualPanelAnchor? _anchor;
    private bool IsTw => _packId == "TW-candidate";
    private string? _mappingError;
    private bool _artifactB;
    private PveDataPack Pack => _manifest!.DataPacks.Single(p => p.Id == _packId);
    private ProfessionProfile Profile => _manifest!.Professions.Single(p => p.Id == _professionId);
    private ProfessionProfile ProfileB => _manifest!.Professions.Single(p => p.Id == _professionB);
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _manifest = await Client.GetFromJsonAsync<ResearchManifest>("data/pve/manifest.json") ?? throw new Exception("無法載入資料索引");
            _packId = _manifest.DataPacks[0].Id; _professionId = _manifest.DefaultProfessionId; _professionB = _professionId;
            await LoadPack();
            try
            {
                var artifacts = ArtifactDataPack.Load(await Client.GetStringAsync("data/artifacts/TW-Mobile-2.3.3/artifact-pack.json"));
                _artifactEngine = new(artifacts);
                _artifactLayout = ArtifactBoardLayout.Load(await Client.GetStringAsync("data/artifacts/TW-Mobile-2.3.3/board-layout.json"), artifacts);
                try {
                    _mappingJson = await Client.GetStringAsync("data/pve/adapters/tw-static-v1.json");
                    _legacyAdapter = new(_configJson, _mappingJson, _artifactEngine);
                    _effectPolicyJson = await Client.GetStringAsync("data/artifacts/TW-Mobile-2.3.3/effect-policy-v1.json");
                    _twEffects = new(_artifactEngine, _effectPolicyJson);
                    _targets = new(await Client.GetStringAsync("data/pve/targets/tw-mobile-2.3.3-v1.json"));
                    _actualPanels = new(_artifactEngine,_twEffects);
                    _target ??= new(_targets.Id,"Hero");
                    _twAdapter = new(_configJson, _legacyAdapter, _twEffects,_targets,_actualPanels);
                } catch (Exception ex) { _mappingError = ex.Message; }
            }
            catch (Exception ex) { _artifactError = ex.Message; }
        }
        catch (Exception ex) { _error = ex.Message; }
    }
    private async Task ChangePack(string id) { _packId = id; await LoadPack(); }
    private async Task LoadPack() {
        _configJson = await Client.GetStringAsync(Pack.ConfigPath); ResetPair();
        if (_artifactEngine is not null && _mappingJson.Length > 0) {
            _legacyAdapter = null; _twAdapter = null; _mappingError = null;
            try { _legacyAdapter = new(_configJson, _mappingJson, _artifactEngine);
                if (_twEffects is not null) _twAdapter = new(_configJson, _legacyAdapter, _twEffects,_targets,_actualPanels); }
            catch (Exception ex) { _mappingError = ex.Message; }
        }
    }
    private void ChangeProfession(string id) { _professionId = id; _professionB = id; _cross = false; ResetPair(); }
    private void ChangeMode(string mode) { _mode = mode; ResetPair(mode); }
    private void ChangeModeB(string mode) { _modeB = mode; _b = Example(ProfileB, mode); BuildChanged(); }
    private void ChangeProfessionB(string id) { _professionB = id; _modeB = ProfileB.LegacyModes.Keys.First(); _b = Example(ProfileB, _modeB); BuildChanged(); }
    private void ChangeCross(bool value) { _cross = value; BuildChanged(); if (!value) { _professionB = _professionId; _modeB = _mode; _b = Example(Profile, _mode); } }
    private ResearchBuild Example(ProfessionProfile profile, string mode) => PveComparison.CreateLegacyExample(JsonSerializer.Deserialize<PveConfig>(_configJson)!, profile, mode);
    private void ResetPair(string? mode = null)
    {
        _mode = mode ?? Profile.LegacyModes.Keys.First(); _modeB = _mode; _professionB = _professionId;
        _a = Example(Profile, _mode); _b = Example(Profile, _mode); _result = null; _inputPair = null; _twA = null; _twB = null; _error = null; _saveMessage = null; _artifactB = false;
        _anchor=null; _target=_targets is null ? null : new(_targets.Id,"Hero");
        var key = StorageKey();
        if (IsTw && LocalStorage.ContainKey(key)) {
            var saved=LocalStorage.GetItem<TwActualPanelSession>(key);
            if(saved?.Current.ProfessionId==_professionId && saved.Current.LegacyMode==_mode
                && saved.Candidate.ProfessionId==_professionId && saved.Candidate.LegacyMode==_mode) {
                _a=saved.Current;_b=saved.Candidate;_anchor=saved.Anchor;_target=saved.Target;
            }
        }
        if (!IsTw && LocalStorage.ContainKey(key)) { var saved = LocalStorage.GetItem<ResearchBuild[]>(key); if (saved?.Length == 2 && saved.All(b => b.ProfessionId == _professionId && b.LegacyMode == _mode)) { _a = saved[0]; _b = saved[1]; } }
    }
    private void SelectArtifactBuild(bool b) { _artifactB = b; }
    private void BuildChanged() { _result = null; _inputPair = null; _twA = null; _twB = null; _saveMessage = null; }
    private void GenerateMappedInputs() {
        try {
            if (IsTw) {
                if (_twAdapter is null) throw new ArgumentException("TW神器來源接線未載入，不回退舊神器");
                if (_anchor is null || _target is null || _actualPanels is null) throw new ArgumentException("請先確認目前盤並建立實際面板錨點");
                if (!_actualPanels.Matches(_anchor,_a!)) throw new ArgumentException("目前實際資料已變更，請明確更新錨點；不自動覆寫");
                var pair = _twAdapter.CompareAnchoredInputs(_anchor, _b!, ProfileB, _target);
                _twA = pair.A; _twB = pair.B; _inputPair = pair.Mapping;
            } else _inputPair = _legacyAdapter!.Compare(_a!, Profile, _b!, ProfileB, _cross);
            _error = null;
        }
        catch (Exception ex) { _inputPair = null; _twA = null; _twB = null; _error = ex.Message; }
    }
    private void Save()
    {
        try
        {
            if (_cross) throw new ArgumentException("跨流派設定請分別切回各流派儲存，避免覆寫同流派基準。");
            if (_artifactEngine is not null) { BuildAttributeLayer.Project(_a!, _artifactEngine); BuildAttributeLayer.Project(_b!, _artifactEngine); }
            if (IsTw) {
                if (_anchor is null || _actualPanels is null || !_actualPanels.Matches(_anchor,_a!)) throw new ArgumentException("請先建立／更新目前錨點再儲存");
                LocalStorage.SetItem(StorageKey(),new TwActualPanelSession { Current=_a!,Candidate=_b!,Anchor=_anchor,Target=_target });
            } else LocalStorage.SetItem(StorageKey(),new[] { _a,_b });
            _error = null; _saveMessage = IsTw ? "已分開儲存實際面板錨點、目前盤、候選盤與TW目標。" : "已儲存此流派 A/B 基礎面板與神器盤。";
        }
        catch (Exception ex) { _error = ex.Message; _saveMessage = null; }
    }
    private string StorageKey()=>PveComparison.StorageKey(Pack,_professionId)+":"+_mode+(IsTw ? ":actual-anchor-v1" : "");
    private void ChangeTarget(string id) {
        try { _targets!.Snapshot(new(_targets.Id,id),null,null);_target=new(_targets.Id,id);BuildChanged();_error=null; }
        catch(Exception ex) { _error=ex.Message; }
    }
    private void CaptureAnchor() {
        try {
            if(_actualPanels is null) throw new ArgumentException("錨定規格尚未載入");
            var first=_anchor is null;
            var captured=_actualPanels.Capture(_a!);
            _anchor=captured;
            if(first) { _b=TwActualPanelAdapter.Copy(_a!);_b.BuildId="CANDIDATE-"+_a!.BuildId; }
            BuildChanged();_error=null;
        } catch(Exception ex) { _error=ex.Message; }
    }
    private void CopyCurrentToCandidate() {
        try { _b=_actualPanels!.Current(_anchor!);_b.BuildId="CANDIDATE-"+_b.BuildId;BuildChanged();_error=null; }
        catch(Exception ex) { _error=ex.Message; }
    }
    private void Calculate() { try { _result = PveComparison.Compare(_configJson, _a!, Profile, _b!, ProfileB, _cross); _error = null; } catch (Exception ex) { _result = null; _error = ex.Message; } }
}
