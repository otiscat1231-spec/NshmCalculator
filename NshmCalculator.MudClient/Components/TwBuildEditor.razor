@using System.Text.Json
@using NshmCalculator.Shared.Research
@using NshmCalculator.Shared.Models.CalculatorModel.FormulaParam.Params
@using NshmCalculator.MudClient.Resources
@using NshmCalculator.Shared.Research.Artifacts
@using System.Globalization
<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6">@Title · @Profile.Name</MudText>
    <MudTextField T="string" Label="Build ID" Value="Build.BuildId" ValueChanged="v => ChangeIdentity(true, v)" />
    <MudTextField T="string" Label="技能循環 ID（尚未確認可留空）" Value="Build.RotationId" ValueChanged="v => ChangeIdentity(false, v)" />
    @if (ArtifactEngine is not null && (!ActualPanel || BuildTag == "A"))
    {
        <details class="mt-4" open>
            <summary>@(ActualPanel ? "目前遊戲實際脫戰面板（已含目前神器）" : "基礎面板（未含本盤神器）")</summary>
            <MudText Typo="Typo.body2">@(ActualPanel ? "直接填目前遊戲實際脫戰面板，避免短暫Buff，不需要拆神器。會傷以百分點輸入；未填保留未知。完成目前盤配置後建立錨點。" : "請填未含本盤神器的數值。會傷以百分點輸入；未填保留未知。")</MudText>
            <MudGrid Class="mt-2">
                @foreach (var input in BuildAttributeLayer.Definitions(ArtifactEngine.Pack).Concat(LegacyAdapter?.AdditionalBaseDefinitions ?? []))
                {
                    <MudItem xs="12" sm="6"><label style="display:block;font-size:13px">
                        @input.Label（@TwArtifactBoard.Unit(input.Unit)）
                        <input type="number" step="any" aria-label="@Title @(ActualPanel ? "實際" : "基礎") @input.Label"
                               data-testid="@(ActualPanel ? $"observed-{BuildTag}-{input.Key}" : $"base-{BuildTag}-{input.Key}")" style="display:block;width:100%;padding:8px;border:1px solid var(--mud-palette-divider);border-radius:4px;background:var(--mud-palette-surface);color:inherit"
                               value="@BaseValue(input.Key)" @onchange="e => ChangeBase(input.Key, e.Value?.ToString())" />
                    </label></MudItem>
                }
            </MudGrid>
            @if (_baseError is not null) { <MudAlert Severity="Severity.Error">@_baseError</MudAlert> }
        </details>
    }
    @if (TwEffects is not null && Build.ProfessionId == "LY" && (!ActualPanel || BuildTag == "A"))
    {
        <details class="mt-4"><summary>@(ActualPanel ? "目前遊戲實際五維（已含目前眾法歸一）" : "五維基礎值（未含眾法歸一）")</summary>
            <p>五個獨立数值；Lv5 首克使用版本化候選規則。留空保留未知，不從 Legacy 合併欄補值。@(ActualPanel ? "候選五維使用候選CORE−目前CORE差量；五維轉攻擊等間接變化仍未建模。" : "")</p>
            @foreach (var dimension in TwEffects.DimensionNames)
            {
                <label style="display:block">@dimension.Value
                    <input type="number" min="0" step="any" data-testid="five-@BuildTag-@dimension.Key"
                        value="@(FiveValues.TryGetValue(dimension.Key, out var v) ? v.ToString(CultureInfo.InvariantCulture) : "")"
                        @onchange="e => ChangeFive(dimension.Key, e.Value?.ToString())" />
                </label>
            }
        </details>
    }
    @if (ActualPanel && BuildTag == "B") { <p>候選面板由固定錨點＋神器差量產生；不另填候選面板，避免修改目前錨點。</p> }
    <details class="mt-4"><summary>Legacy 候選模型輸入（獨立於新神器面板）</summary>
    <MudGrid Class="mt-2">
        @foreach (var input in TwPveText.CommonInputs)
        {
            if (Build.Parameters.TryGetValue(input.Code, out var parameter))
            {
                <MudItem xs="12" sm="6"><MudNumericField T="double" Label="@input.Label" Value="parameter.NumberValue" ValueChanged="v => ChangeLegacy(parameter, v)" /></MudItem>
            }
        }
    </MudGrid>
    </details>
    <MudExpansionPanels Class="mt-4"><MudExpansionPanel Text="進階設定：完整 Legacy 參數">
        <MudText Typo="Typo.body2">包含目標、技能占比、神器、內功、特質等全部模型輸入。職業欄由流派選擇控制。</MudText>
        <MudButton OnClick="LoadJson">載入目前參數</MudButton>
        <MudTextField T="string" Label="完整參數 JSON" Lines="10" @bind-Value="_json" />
        <MudButton OnClick="ApplyJson">套用參數</MudButton>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    </MudExpansionPanel></MudExpansionPanels>
</MudPaper>
@code {
    [Parameter] public bool ActualPanel { get; set; }
    private Dictionary<string,decimal> PanelValues => ActualPanel ? Build.ObservedAttributes : Build.BaseAttributes;
    private Dictionary<string,decimal> FiveValues => ActualPanel ? Build.ObservedFiveDimensions : Build.BaseFiveDimensions;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public ResearchBuild Build { get; set; } = new();
    [Parameter] public ProfessionProfile Profile { get; set; } = new();
    [Parameter] public ArtifactBoardEngine? ArtifactEngine { get; set; }
    [Parameter] public LegacyStaticInputAdapter? LegacyAdapter { get; set; }
    [Parameter] public TwArtifactEffectAdapter? TwEffects { get; set; }
    [Parameter] public string BuildTag { get; set; } = "A";
    [Parameter] public EventCallback Changed { get; set; }
    private string _json = "";
    private string? _error;
    private string? _baseError;
    private async Task ChangeIdentity(bool buildId, string value) {
        if (buildId) Build.BuildId = value; else Build.RotationId = value;
        await Changed.InvokeAsync();
    }
    private async Task ChangeLegacy(ParamValue parameter, double value) {
        parameter.NumberValue = value; await Changed.InvokeAsync();
    }
    private string BaseValue(string key) => PanelValues.TryGetValue(key, out var value)
        ? value.ToString(CultureInfo.InvariantCulture) : "";
    private async Task ChangeFive(string key, string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) FiveValues.Remove(key);
        else if (decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && value >= 0)
            FiveValues[key] = value;
        else { _baseError = "五維請填非負數字，或留空表示未知。"; return; }
        _baseError = null; await Changed.InvokeAsync();
    }
    private async Task ChangeBase(string key, string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) PanelValues.Remove(key);
        else if (decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value)) PanelValues[key] = value;
        else { _baseError = "請輸入有效數字，或留空表示未知。"; return; }
        _baseError = null;
        await Changed.InvokeAsync();
    }
    private void LoadJson() => _json = JsonSerializer.Serialize(Build.Parameters, new JsonSerializerOptions { WriteIndented = true });
    private async Task ApplyJson()
    {
        try
        {
            var values = JsonSerializer.Deserialize<Dictionary<string, ParamValue>>(_json)
                ?? throw new ArgumentException("參數不能為空");
            if (values.Values.Any(v => v is null)) throw new ArgumentException("參數值不能為null");
            if (Build.Parameters.Keys.Except(values.Keys).Any()) throw new ArgumentException("請保留完整參數欄位");
            values["KG_001"] = new ParamValue { NumberMode = false, StringValue = Build.LegacyMode };
            Build.Parameters = values;
            _error = null;
            await Changed.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
